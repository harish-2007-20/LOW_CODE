 application "SMART_CITY "
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Complaint_Assignments
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Assignment_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Complaint
			(
				type = picklist	
				values  = Smart_City_Complaints.ID
    			displayformat = [Complaint_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Assigned_Staff
			(
				type = picklist	
				values  = Staff_Profiles.ID
    			displayformat = [Staff_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Assignment_Date
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Task_Status
			(
				type = picklist
				maxchar = 100
				values = {"Assigned","Accepted","In Progress","On Hold","Completed","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Instructions
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Work_Started_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Completion_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Staff_Remarks
			(
				type = list	
				values = {"Choice 1","Choice 2","Choice 3"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Complaint_Categories
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Category_Name
			(
    			type = text
				displayname = "Category Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category_Code
			(
    			type = text
				displayname = "Category Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Category_Description
			(
    			type = textarea
				displayname = "Category Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Departments
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Default_Priority
			(
				type = picklist
				displayname = "Default Priority"
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have SLA_Days
			(
				type = number
				displayname = "SLA Days"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Is_Active
			(
    			type = checkbox
				displayname = "Is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Departments
		{
			success message = "Department Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Department_Name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have unique Department_Code
			(
    			type = text
				displayname = "Department Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Description
			(
    			type = textarea
				displayname = "Department Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Department_Head_Email
			(
    			type = email
				displayname = "Department Head Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Office_Address
			(
    			type = textarea
				displayname = "Office Address"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have is_Active
			(
    			type = checkbox
				displayname = "is Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Smart_City_Complaints
		{
			success message = "Data Added Successfully!"
			Complaint_information
			(
				type = section
				displayname = "Complaint information"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			Complaint_ID
			(
    			type = autonumber
				displayname = "Complaint ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Complaint_Title
			(
    			type = text
				displayname = "Complaint Title"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Complaint_Category
			(
				type = picklist	
				displayname = "Complaint Category"
				values  = Complaint_Categories.ID
    			displayformat = [Category_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Responsible_Department
			(
				type = picklist	
				values  = Departments.ID
    			displayformat = [Department_Name]
				sortorder = ascending
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			SLA_Deadline
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			SLA_Status
			(
				type = picklist
				maxchar = 100
				values = {"Within SLA","Due Soon","Overdue","Met"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Escalation_Level
			(
				type = picklist
				maxchar = 100
				values = {"None","Level 1","Level 2","Level 3"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
				type = list	
				values = {"Choice 1","Choice 2","Choice 3"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Complaint_Photo
			(
    			type = image
				displayname = "Complaint Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reported_Date
			(
    			type = date
				displayname = "Reported Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","High","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Submitted","Under Review","Assigned","In Progress","On Hold","Resolved","Closed","Rejected","Reopened"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Citizen_information
			(
				type = section
				displayname = "Citizen information"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Citizen_Name
			(
    			type = text
				displayname = "Citizen Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Citizen_Email
			(
    			type = email
				displayname = "Citizen Email"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Citizen_Phone
			(
    			type = phonenumber
				displayname = "Citizen Phone"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Complaint_location
			(
				type = section
				displayname = "Complaint location"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Ward
			(
				type = picklist	
				values  = Wards.ID
    			displayformat = [Ward_Name]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Area_Name
			(
    			type = text
				displayname = "Area Name"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Street_Address
			(
    			type = textarea
				displayname = "Street Address"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Postal_Code
			(
    			type = text
				displayname = "Postal Code"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Latitude
			(
				type = decimal
	 			row = 3
	 			column = 1   
				width = medium
			)
			Longitude
			(
				type = decimal
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
